<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="01-use-cases" name="Варианты использования"><mxGraphModel dx="1280" dy="850" grid="1" page="1" pageWidth="1280" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="u" value="Пользователь&#10;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;whiteSpace=wrap;html=0;fillColor=#f3f7fd;strokeColor=#476a91;fontColor=#173454;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="350" width="150" height="95" /></mxCell><mxCell id="a" value="Администратор&#10;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;whiteSpace=wrap;html=0;fillColor=#f3f7fd;strokeColor=#476a91;fontColor=#173454;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="350" width="180" height="95" /></mxCell><mxCell id="common" value="Обе роли&#10;Войти / выйти / открыть справку&#10;Поиск, фильтры, сортировка в пределах прав" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f7fd;strokeColor=#476a91;fontColor=#173454;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="70" width="460" height="115" /></mxCell><mxCell id="own" value="Действия пользователя&#10;Просмотреть свои назначенные задачи&#10;Изменить статус своей задачи&#10;Сформировать отчёт по своим задачам" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f7fd;strokeColor=#476a91;fontColor=#173454;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="255" y="245" width="390" height="170" /></mxCell><mxCell id="admin" value="Действия администратора&#10;Все задачи / задачи исполнителя&#10;Создать / редактировать / удалить задачу&#10;Назначить ответственного&#10;Изменить статус по общему правилу&#10;Создать / удалить пользователя&#10;Изменить логин и роль пользователя&#10;Сбросить пароль&#10;Отчёт по выбранным задачам&#10;Экспорт задач / пользователей в CSV" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f7fd;strokeColor=#476a91;fontColor=#